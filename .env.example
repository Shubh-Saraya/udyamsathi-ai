# Server-side data.gov.in key. Keep it only in .env; never expose it in frontend code.
DATA_GOV_API_KEY=
# Default is true: show clearly labelled synthetic presentation estimates when official cache data is absent.
# Set false to show only official cache data and INSUFFICIENT_EVIDENCE states.
PRESENTATION_DEMO_MODE=true
# Server-side Google Places API (New) key. Optional for live nearby-place enrichment.
GOOGLE_MAPS_API_KEY=
# Browser-restricted Maps JavaScript API key. Optional for map rendering.
GOOGLE_MAPS_MAPS_JS_KEY=
# Optional grounded AI provider key. The deterministic advisory layer works without it.
AI_API_KEY=
DATABASE_URL=
